- fakellm: taskset -c 1 bench/fakellm --port 18080 --ttft-ms 20 --tokens-per-second 1000 --tokens 64
- llmbench: nice -n 19 ionice -c3 taskset -c 2,3 bench/llmbench --port <P> --requests 500 --concurrency 16 --tokens 64 [--stream] --json
